<div class="view view--quadrant">
	<div class="quote-font layout layout--row">
		<div class="stretch-y flex flex--col flex--top">
			<span class="quote-font quote-mark-top value--small value--large text--gray-40">“</span>
		</div>
		<div id="quote" class="value--small value--xlarge text--black" data-value-fit="true" data-value-fit-max-height="170">
			<span class="quote-font">
			{% if data.quote_html %}
				{{ data.quote_html }}
			{% else %}
				Unable to load a quote.
			{% endif %}
			</span>
		</div>
		<div class="stretch-y flex flex--col flex--bottom">
			<div class="quote-font quote-mark-bottom text--gray-40 value--small value--large">”</div>
		</div>
	</div>
	{{ wisdom_quote_footer_short }}
</div>
<style>
	.quote-mark-bottom {
		display: inline-block;
		transform: translateY(0.75em);
	}
</style>